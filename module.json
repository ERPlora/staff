{
  "id": "staff",
  "name": "Staff",
  "version": "2.3.5",
  "description": "Employees, roles, schedules and time-off requests.",
  "agent": {
    "description": "Manages staff members, roles, schedules and time-off requests: list, create, update and deactivate employees, manage work schedules, and approve or reject time-off.",
    "keywords": [
      "staff",
      "employee",
      "roles",
      "schedule",
      "time-off",
      "hr",
      "personnel"
    ]
  },
  "depends_on": [],
  "permissions": [
    "staff.view_staff_member",
    "staff.view_compensation",
    "staff.add_staff_member",
    "staff.change_staff_member",
    "staff.delete_staff_member",
    "staff.view_time_off",
    "staff.view_time_off_detail",
    "staff.manage_time_off",
    "staff.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "staff.view_staff_member",
      "staff.add_staff_member",
      "staff.change_staff_member",
      "staff.view_time_off",
      "staff.manage_time_off",
      "staff.manage_settings",
      "staff.view_compensation",
      "staff.view_time_off_detail"
    ],
    "employee": [
      "staff.view_staff_member",
      "staff.view_time_off"
    ],
    "cashier": [
      "staff.view_staff_member"
    ]
  },
  "navigation": [
    {
      "id": "staff",
      "label": "Staff",
      "icon": "people-outline",
      "component": "erp-staff-members"
    },
    {
      "id": "roles",
      "label": "Roles",
      "icon": "shield-outline",
      "component": "erp-staff-roles"
    },
    {
      "id": "time_off",
      "label": "Time Off",
      "icon": "calendar-outline",
      "component": "erp-staff-time-off"
    },
    {
      "id": "schedules",
      "label": "Horarios",
      "icon": "time-outline",
      "component": "erp-staff-schedules"
    }
  ],
  "settings": {
    "title": "Staff",
    "icon": "people-outline",
    "schema": "schemas/settings_update.json",
    "get": "staff.settings.get",
    "set": "staff.settings.update"
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_termination_reason.sql",
      "migrations/postgres/003_worktime_hhmm.sql",
      {
        "file": "migrations/postgres/004_worktime_hhmm_backfill.sql",
        "kind": "backfill"
      },
      {
        "file": "migrations/postgres/005_member_user_link_dedupe.sql",
        "kind": "backfill"
      },
      "migrations/postgres/006_member_user_link_unique.sql"
    ]
  },
  "queries": {
    "staff.members.list": {
      "permission": "staff.view_staff_member",
      "sql": "queries/members_list.sql",
      "list": {
        "search": [
          "first_name",
          "last_name",
          "full_name",
          "email",
          "phone",
          "role_name"
        ],
        "sort": [
          "id",
          "first_name",
          "last_name",
          "full_name",
          "email",
          "phone",
          "role_id",
          "role_name",
          "status",
          "is_bookable",
          "hire_date",
          "color",
          "user_id"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "first_name": {
            "op": "like"
          },
          "last_name": {
            "op": "like"
          },
          "full_name": {
            "op": "like"
          },
          "email": {
            "op": "like"
          },
          "phone": {
            "op": "like"
          },
          "role_id": {
            "op": "eq"
          },
          "role_name": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "is_bookable": {
            "op": "eq"
          },
          "hire_date": {
            "op": "range"
          },
          "color": {
            "op": "eq"
          },
          "user_id": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all staff members with their status and role."
      },
      "expose_api": true
    },
    "staff.members.get": {
      "permission": "staff.view_staff_member",
      "sql": "queries/member_get.sql",
      "ai": {
        "description": "Returns the details of a single staff member by their identifier."
      },
      "expose_api": true
    },
    "staff.members.by_user": {
      "permission": "staff.view_staff_member",
      "sql": "queries/member_by_user.sql"
    },
    "staff.members.compensation": {
      "permission": "staff.view_compensation",
      "sql": "queries/members_compensation.sql"
    },
    "staff.roles.list": {
      "permission": "staff.view_staff_member",
      "sql": "queries/roles_list.sql",
      "list": {
        "search": [
          "name",
          "description"
        ],
        "sort": [
          "id",
          "name",
          "description",
          "color",
          "is_active",
          "member_count"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "description": {
            "op": "like"
          },
          "color": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "member_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all available staff roles and their assigned permissions."
      },
      "expose_api": true
    },
    "staff.time_off.list": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_list.sql",
      "list": {
        "search": [
          "staff_name"
        ],
        "sort": [
          "id",
          "staff_id",
          "staff_name",
          "leave_type",
          "start_date",
          "end_date",
          "is_full_day",
          "start_time",
          "end_time",
          "status",
          "approved_by",
          "approved_at"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "staff_id": {
            "op": "eq"
          },
          "staff_name": {
            "op": "like"
          },
          "leave_type": {
            "op": "eq"
          },
          "start_date": {
            "op": "range"
          },
          "end_date": {
            "op": "range"
          },
          "is_full_day": {
            "op": "eq"
          },
          "start_time": {
            "op": "eq"
          },
          "end_time": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "approved_by": {
            "op": "eq"
          },
          "approved_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists time-off requests for staff members, optionally filtered by status or member."
      }
    },
    "staff.time_off.detail": {
      "permission": "staff.view_time_off_detail",
      "sql": "queries/time_off_detail.sql"
    },
    "staff.time_off.today": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_today.sql",
      "ai": {
        "description": "Lists approved time-off entries whose date range covers today (who is unavailable today)."
      }
    },
    "staff.time_off.overlapping": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_overlapping.sql"
    },
    "staff.time_off.active_for_member": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_active_for_member.sql"
    },
    "staff.time_off.conflicts_for": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_conflicts_for.sql"
    },
    "staff.members.stats": {
      "permission": "staff.view_staff_member",
      "sql": "queries/members_stats.sql",
      "ai": {
        "description": "Returns aggregated staff statistics (total/active/on-leave members, members on leave today, pending time-off requests)."
      }
    },
    "staff.commissions.summary": {
      "permission": "staff.view_compensation",
      "expose_api": true,
      "sql": "queries/commissions_summary.sql",
      "ai": {
        "description": "Returns each active staff member's staff_id, the hub user_id their record hangs from (null when none), full name and commission_rate (percent). The commission side of the per-professional day close: combine with sales.by_staff to compute commission = gross_total x commission_rate/100. Since sales#179 a sale is attributed either to a staff_id or to the hub user of the till, so BOTH ids of a row name the same person and their grosses are added together before applying the rate."
      }
    },
    "staff.settings.get": {
      "permission": "staff.view_staff_member",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Returns the general configuration settings for the staff module."
      }
    },
    "staff.schedules.list_for_member": {
      "permission": "staff.view_staff_member",
      "sql": "queries/schedules_list_for_member.sql",
      "ai": {
        "description": "Lists the work schedules assigned to a specific staff member."
      }
    },
    "staff.services.list_for_member": {
      "permission": "staff.view_staff_member",
      "sql": "queries/services_list_for_member.sql",
      "ai": {
        "description": "Lists the services (competencies) a staff member performs, with per-professional duration/price overrides and the primary flag."
      },
      "expose_api": true
    },
    "staff.services.eligible_for_service": {
      "permission": "staff.view_staff_member",
      "sql": "queries/services_eligible_for_service.sql",
      "ai": {
        "description": "Lists the active, bookable staff members eligible to perform a given service (by service_id), with their duration/price overrides. The authoritative filter for booking."
      },
      "expose_api": true
    },
    "staff.schedules.hours_for_member": {
      "permission": "staff.view_staff_member",
      "sql": "queries/schedules_hours_for_member.sql",
      "ai": {
        "description": "Lists the weekly working-hour intervals (per weekday, with breaks) of every schedule template of a staff member."
      },
      "expose_api": true
    },
    "staff.schedules.get": {
      "permission": "staff.view_staff_member",
      "sql": "queries/schedule_get.sql"
    },
    "staff.availability.for_member": {
      "permission": "staff.view_staff_member",
      "sql": "queries/availability_for_member.sql",
      "ai": {
        "description": "Effective availability of a staff member for a date range (date_from/date_to, ISO dates): the intervals of their governing schedule minus approved time off. The authoritative answer to when a professional can work."
      },
      "expose_api": true
    },
    "staff.availability.day_at": {
      "permission": "staff.view_staff_member",
      "sql": "queries/availability_day_at.sql"
    },
    "staff.availability.days_ahead": {
      "permission": "staff.view_staff_member",
      "sql": "queries/availability_days_ahead.sql"
    },
    "staff.availability.team_day_at": {
      "permission": "staff.view_staff_member",
      "sql": "queries/availability_team_day_at.sql"
    },
    "staff.members.mine": {
      "permission": "staff.view_staff_member",
      "sql": "queries/member_mine.sql",
      "ai": {
        "description": "Returns the staff record of the CURRENT user (the one hanging from their hub user), including their own hourly rate and commission. Empty when the user has no staff record."
      },
      "expose_api": true
    },
    "staff.time_off.mine": {
      "permission": "staff.view_time_off",
      "sql": "queries/time_off_mine.sql",
      "ai": {
        "description": "Lists the time-off requests of the CURRENT user (their own record), with reason and notes."
      },
      "expose_api": true
    }
  },
  "commands": {
    "staff.members.create": {
      "permission": "staff.add_staff_member",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_staff_member"
      },
      "schema": "schemas/member_create.json",
      "reads": [
        {
          "query": "staff.members.by_user",
          "params": {
            "user_id": "payload.user_id"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.member.created"
      ],
      "ai": {
        "description": "Creates a new staff member and emits a member-created event."
      },
      "expose_api": true
    },
    "staff.members.update": {
      "permission": "staff.change_staff_member",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_staff_member"
      },
      "schema": "schemas/member_update.json",
      "reads": [
        {
          "query": "staff.members.by_user",
          "params": {
            "user_id": "payload.user_id"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.member.updated"
      ],
      "ai": {
        "description": "Updates the details of an existing staff member."
      },
      "expose_api": true
    },
    "staff.members.deactivate": {
      "permission": "staff.delete_staff_member",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "deactivate_staff_member"
      },
      "schema": "schemas/member_deactivate.json",
      "reads": [
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.time_off.active_for_member",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.member.deactivated"
      ],
      "ai": {
        "description": "Deactivates a staff member without permanently deleting them."
      }
    },
    "staff.members.delete": {
      "permission": "staff.delete_staff_member",
      "transaction": true,
      "sql": [
        "commands/member_delete.sql"
      ],
      "schema": "schemas/member_delete.json",
      "emit": [
        "staff.member.terminated"
      ],
      "ai": {
        "description": "Terminates a staff member (the only road to status `terminated`): stamps the termination date (today by default) and reason, un-books them and soft-deletes the record."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.member_not_found",
        "message": "That staff member does not exist in this business."
      }
    },
    "staff.members.bulk_create": {
      "permission": "staff.add_staff_member",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_staff_members"
      },
      "schema": "schemas/member_bulk_create.json",
      "reads": [
        "staff.roles.list"
      ],
      "emit": [
        "staff.member.created"
      ],
      "ai": {
        "description": "Creates multiple staff members in a single batch operation."
      }
    },
    "staff.roles.create": {
      "permission": "staff.manage_settings",
      "transaction": true,
      "sql": [
        "commands/role_create.sql"
      ],
      "schema": "schemas/role_create.json",
      "emit": [
        "staff.role.created"
      ],
      "ai": {
        "description": "Creates a new staff role with its associated permissions."
      }
    },
    "staff.time_off.create": {
      "permission": "staff.manage_time_off",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_time_off"
      },
      "schema": "schemas/time_off_create.json",
      "reads": [
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.time_off.overlapping",
          "params": {
            "staff_id": "payload.staff_id",
            "start_date": "payload.start_date",
            "end_date": "payload.end_date"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.time_off.created"
      ],
      "ai": {
        "description": "Registers a new time-off request for a staff member."
      }
    },
    "staff.time_off.set_status": {
      "permission": "staff.manage_time_off",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_time_off_status"
      },
      "schema": "schemas/time_off_set_status.json",
      "reads": [
        {
          "query": "staff.time_off.detail",
          "params": {
            "time_off_id": "payload.time_off_id"
          },
          "required": true
        },
        {
          "query": "staff.time_off.conflicts_for",
          "params": {
            "time_off_id": "payload.time_off_id"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.time_off.status_changed"
      ],
      "ai": {
        "description": "Changes the status of a time-off request (e.g. approved, rejected)."
      }
    },
    "staff.schedules.create": {
      "permission": "staff.manage_settings",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_schedule"
      },
      "schema": "schemas/schedule_create.json",
      "reads": [
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.schedule.created"
      ],
      "ai": {
        "description": "Creates a new work schedule and assigns it to a staff member."
      }
    },
    "staff.settings.update": {
      "permission": "staff.manage_settings",
      "transaction": true,
      "sql": [
        "commands/_settings_ensure.sql",
        "commands/settings_update.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.settings_not_saved",
        "message": "The staff settings could not be saved for this business."
      },
      "schema": "schemas/settings_update.json",
      "emit": [
        "staff.settings.updated"
      ],
      "ai": {
        "description": "Updates the general configuration settings for the staff module."
      }
    },
    "staff._deactivate_member": {
      "permission": "staff.delete_staff_member",
      "sql": [
        "commands/_deactivate_member.sql"
      ]
    },
    "staff._insert_member": {
      "permission": "staff.add_staff_member",
      "transaction": true,
      "sql": [
        "commands/member_create.sql"
      ],
      "schema": "schemas/member_create.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.role_not_found",
        "message": "That role is not available: it does not exist in this business, or it has been deleted or retired."
      }
    },
    "staff._update_member": {
      "permission": "staff.change_staff_member",
      "transaction": true,
      "sql": [
        "commands/member_update.sql"
      ],
      "schema": "schemas/member_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.member_update_rejected",
        "message": "The staff member could not be updated: they do not exist in this business, or the role you picked does not."
      }
    },
    "staff._unset_default_schedules": {
      "permission": "staff.manage_settings",
      "sql": [
        "commands/_unset_default_schedules.sql"
      ]
    },
    "staff._insert_schedule": {
      "permission": "staff.manage_settings",
      "sql": [
        "commands/_insert_schedule.sql"
      ]
    },
    "staff._insert_working_hours": {
      "permission": "staff.manage_settings",
      "sql": [
        "commands/_insert_working_hours.sql"
      ]
    },
    "staff._insert_time_off": {
      "permission": "staff.manage_time_off",
      "sql": [
        "commands/_insert_time_off.sql"
      ]
    },
    "staff._set_time_off_status": {
      "permission": "staff.manage_time_off",
      "sql": [
        "commands/_set_time_off_status.sql"
      ]
    },
    "staff.services.assign": {
      "permission": "staff.change_staff_member",
      "transaction": true,
      "sql": [
        "commands/_unset_primary_service.sql",
        "commands/service_assign.sql"
      ],
      "schema": "schemas/service_assign.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.service_assign_rejected",
        "message": "The service could not be assigned: that staff member does not exist in this business."
      },
      "emit": [
        "staff.service.assigned"
      ],
      "ai": {
        "description": "Assigns a service (competency) to a staff member, optionally with a custom duration/price and as their primary service. Repeating the assignment updates it."
      },
      "expose_api": true
    },
    "staff.services.update": {
      "permission": "staff.change_staff_member",
      "transaction": true,
      "sql": [
        "commands/_unset_primary_service.sql",
        "commands/service_update.sql"
      ],
      "schema": "schemas/service_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.service_not_found",
        "message": "That service assignment does not exist in this business."
      },
      "emit": [
        "staff.service.updated"
      ],
      "ai": {
        "description": "Edits a staff member's service assignment: custom duration/price, primary and active flags."
      }
    },
    "staff.services.remove": {
      "permission": "staff.change_staff_member",
      "transaction": true,
      "sql": [
        "commands/service_remove.sql"
      ],
      "schema": "schemas/service_remove.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.service_not_found",
        "message": "That service assignment does not exist in this business."
      },
      "emit": [
        "staff.service.removed"
      ],
      "ai": {
        "description": "Removes a service from a staff member (they no longer perform it)."
      }
    },
    "staff.schedules.update": {
      "permission": "staff.manage_settings",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_schedule"
      },
      "schema": "schemas/schedule_update.json",
      "reads": [
        {
          "query": "staff.schedules.get",
          "params": {
            "schedule_id": "payload.schedule_id"
          },
          "required": true
        }
      ],
      "emit": [
        "staff.schedule.updated"
      ],
      "ai": {
        "description": "Edits a schedule template (name, validity, default flag) and REPLACES its weekly working hours."
      }
    },
    "staff.schedules.set_active": {
      "permission": "staff.manage_settings",
      "transaction": true,
      "sql": [
        "commands/schedule_set_active.sql"
      ],
      "schema": "schemas/schedule_set_active.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "staff.schedule_not_found",
        "message": "That schedule does not exist in this business."
      },
      "emit": [
        "staff.schedule.updated"
      ],
      "ai": {
        "description": "Activates or deactivates a schedule template; an inactive template never governs availability."
      }
    },
    "staff.schedules.delete": {
      "permission": "staff.manage_settings",
      "transaction": true,
      "sql": [
        "commands/_retire_working_hours.sql",
        "commands/schedule_delete.sql"
      ],
