{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "staff.members.update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "staff_id"
  ],
  "properties": {
    "staff_id": {
      "type": "string",
      "minLength": 1
    },
    "first_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "default": null
    },
    "last_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "default": null
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 254,
      "default": null
    },
    "phone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "default": null
    },
    "role_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Staff role of this hub. null = keep; '' = clear."
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Usuario del Hub (hub_user.id) del que cuelga esta ficha. Vacío o null = ficha sin acceso al Hub."
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "active",
        "inactive",
        "on_leave",
        null
      ],
      "default": null,
      "description": "`terminated` is NOT reachable here: only `staff.members.delete` terminates (date, reason, soft-delete, event)."
    },
    "hire_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "default": null
    },
    "hourly_rate": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": null,
      "description": "Céntimos por hora (dinero, ADR-0123)"
    },
    "commission_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "default": null
    },
    "is_bookable": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        0,
        1,
        null
      ],
      "default": null
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "specialties": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "employee_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 50,
      "default": null
    },
    "color": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 7,
      "default": null
    },
    "booking_buffer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": null,
      "description": "Minutes between appointments."
    }
  }
}
