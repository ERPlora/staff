{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "staff.settings.update",
  "description": "Configuración de personal (singleton por hub). La UI envía el snapshot completo (upsert). Tipos PLANOS a propósito (staff#24): el renderer genérico del shell no lee arrays de tipos — un flag es `integer` + `enum: [0, 1]` (columna INTEGER, paridad SQLite/Postgres) y el shell lo pinta como interruptor.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_work_start": {
      "type": "string",
      "title": "Working day starts (HH:MM)",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "default": "09:00",
      "description": "Default start of the working day. A night shift (end before start) is valid."
    },
    "default_work_end": {
      "type": "string",
      "title": "Working day ends (HH:MM)",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "default": "18:00",
      "description": "Default end of the working day. If it is earlier than the start, the shift is taken to cross midnight."
    },
    "default_break_duration": {
      "type": "integer",
      "title": "Break duration (minutes)",
      "minimum": 0,
      "maximum": 480,
      "default": 60,
      "description": "Between 0 and 480 minutes."
    },
    "min_advance_booking": {
      "type": "integer",
      "title": "Minimum booking notice (hours)",
      "minimum": 0,
      "maximum": 168,
      "default": 1,
      "description": "Between 0 and 168 hours (one week)."
    },
    "max_daily_hours": {
      "type": "integer",
      "title": "Maximum hours per day",
      "minimum": 1,
      "maximum": 24,
      "default": 12,
      "description": "Between 1 and 24 hours."
    },
    "overtime_threshold": {
      "type": "integer",
      "title": "Overtime threshold (hours/week)",
      "minimum": 1,
      "maximum": 168,
      "default": 40,
      "description": "Between 1 and 168 hours per week."
    },
    "show_staff_photos": {
      "type": "integer",
      "title": "Show staff photos",
      "enum": [
        0,
        1
      ],
      "default": 1
    },
    "show_staff_bio": {
      "type": "integer",
      "title": "Show staff bio",
      "enum": [
        0,
        1
      ],
      "default": 1
    },
    "allow_staff_selection": {
      "type": "integer",
      "title": "Let customers choose the professional",
      "enum": [
        0,
        1
      ],
      "default": 1
    },
    "notify_new_appointment": {
      "type": "integer",
      "title": "Notify on a new appointment",
      "enum": [
        0,
        1
      ],
      "default": 1
    },
    "notify_cancellation": {
      "type": "integer",
      "title": "Notify on a cancellation",
      "enum": [
        0,
        1
      ],
      "default": 1
    }
  }
}
